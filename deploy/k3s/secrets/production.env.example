# Copy once to .env.prod; this is raw input for scripts/prepare-deployment-secrets.py.
# Use literal KEY=value lines without shell quotes, expansion, or inline comments.
# Store generated secrets here before running the helper; never commit real values.
EDGAR_IDENTITY=<TRUTHFUL_PRODUCT_AND_CONTACT_EMAIL>
OPENAI_API_KEY=<OPENAI_PROJECT_API_KEY>
GOOGLE_CLIENT_ID=<PRODUCTION_GOOGLE_CLIENT_ID>
GOOGLE_CLIENT_SECRET=<PRODUCTION_GOOGLE_CLIENT_SECRET>
GOOGLE_ADMIN_EMAILS=<PRIMARY_ADMIN_GOOGLE_EMAIL>
SESSION_SECRET=<RANDOM_SECRET_AT_LEAST_32_CHARACTERS>
INGESTION_API_TOKEN=<RAW_SHARED_TOKEN_AT_LEAST_16_CHARACTERS>
POSTGRES_PASSWORD=<SEPARATE_RAW_SUPERUSER_PASSWORD>
APP_DATABASE_PASSWORD=<RAW_APPLICATION_PASSWORD>
# Kestra database and basic-auth passwords enter unquoted YAML: start with a letter or underscore;
# use A-Z, a-z, 0-9, _ or -, and avoid boolean/null words such as true, no, or null.
KESTRA_DATABASE_PASSWORD=<RAW_KESTRA_DATABASE_PASSWORD>
# Use an email address for the private Kestra login username.
KESTRA_BASIC_AUTH_USERNAME=<KESTRA_USERNAME_EMAIL>
# At least 8 characters including an uppercase letter and digit.
KESTRA_BASIC_AUTH_PASSWORD=<RAW_KESTRA_LOGIN_PASSWORD>

# Application operator settings. Review these before preparing deployment configuration.
DATABASE_POOL_MIN_SIZE=1
DATABASE_POOL_MAX_SIZE=4
DATABASE_POOL_TIMEOUT_SECONDS=10
DATABASE_STARTUP_TIMEOUT_SECONDS=10
LOG_LEVEL=INFO
EDGAR_RATE_LIMIT_PER_SEC=6
EDGAR_ACCESS_MODE=CAUTION
MAX_FILING_DOCUMENT_BYTES=50000000
MAX_FILING_NARRATIVE_CHARS=20000000
KESTRA_TIMEOUT_SECONDS=10
KESTRA_MAX_RETRIES=2
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
OPENAI_CHAT_MODEL=gpt-5.4-mini
OPENAI_JUDGE_MODEL=gpt-5.4-mini
OPENAI_TIMEOUT_SECONDS=30
CHUNK_SIZE_CHARS=2400
CHUNK_OVERLAP_CHARS=240
PARSER_VERSION=corpus-heading-sanitized-v2
CHUNKING_VERSION=character-v1
INDEX_VERSION=vector-v1
SESSION_LIFETIME_DAYS=7
DEFAULT_USER_LIFETIME_BUDGET_USD=1.00
RESEARCH_COST_RESERVATION_USD=0.10
CORPUS_PREPARATION_COST_RESERVATION_USD=0.05
