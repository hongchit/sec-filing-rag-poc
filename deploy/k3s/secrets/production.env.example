# Copy once to .env.prod; this is raw input for scripts/prepare-deployment-secrets.py.
# Use literal KEY=value lines without shell quotes, expansion, or inline comments.
# Store generated secrets here before running the helper; never commit real values.
EDGAR_IDENTITY=<TRUTHFUL_PRODUCT_AND_CONTACT_EMAIL>
OPENAI_API_KEY=<OPENAI_PROJECT_API_KEY>
GOOGLE_CLIENT_ID=<PRODUCTION_GOOGLE_CLIENT_ID>
GOOGLE_CLIENT_SECRET=<PRODUCTION_GOOGLE_CLIENT_SECRET>
GOOGLE_ADMIN_EMAILS=<PRIMARY_ADMIN_GOOGLE_EMAIL>
SESSION_SECRET=<RANDOM_SECRET_AT_LEAST_32_CHARACTERS>
INGESTION_API_TOKEN=<RAW_SHARED_TOKEN_AT_LEAST_16_CHARACTERS>
POSTGRES_PASSWORD=<SEPARATE_RAW_SUPERUSER_PASSWORD>
APP_DATABASE_PASSWORD=<RAW_APPLICATION_PASSWORD>
# Kestra values enter unquoted YAML: start with a letter or underscore; use A-Z, a-z, 0-9, _ or -.
# Avoid boolean/null words such as true, no, or null.
KESTRA_DATABASE_PASSWORD=<RAW_KESTRA_DATABASE_PASSWORD>
KESTRA_BASIC_AUTH_USERNAME=<KESTRA_USERNAME>
# At least 8 characters including an uppercase letter and digit.
KESTRA_BASIC_AUTH_PASSWORD=<RAW_KESTRA_LOGIN_PASSWORD>
