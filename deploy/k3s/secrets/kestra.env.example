# Copy to .deploy-secrets/kestra.env and replace every placeholder outside Git.
KESTRA_DATABASE_NAME=kestra
KESTRA_DATABASE_USER=kestra
KESTRA_DATABASE_PASSWORD=<SAME_KESTRA_DATABASE_PASSWORD>
KESTRA_BASIC_AUTH_USERNAME=<SAME_KESTRA_ADMIN_USERNAME>
KESTRA_BASIC_AUTH_PASSWORD=<SAME_KESTRA_ADMIN_PASSWORD>
# Kestra OSS requires the raw shared ingestion token to be base64-encoded here.
SECRET_INGESTION_API_TOKEN=<BASE64_OF_SHARED_INGESTION_TOKEN>
