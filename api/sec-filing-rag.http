@baseUrl = http://{{$processEnv APP_HOST}}:{{$processEnv APP_PORT}}
@internalToken = {{$processEnv INGESTION_API_TOKEN}}
@contentType = application/json

########################################################
### Request: GET /api/health
### Summary: Health
### Description: Check application database readiness.
########################################################


GET {{baseUrl}}/api/health
Content-Type: {{contentType}}
Authorization: {{internalToken}}


##################################################################
### Request: GET /api/companies
### Summary: Companies
### Description: List configured companies and corpus readiness.
##################################################################


GET {{baseUrl}}/api/companies
Content-Type: {{contentType}}
Authorization: {{internalToken}}


###################################################################################
### Request: GET /api/companies/{ticker}/status
### Summary: Company Status
### Description: Inspect application-owned corpus status without querying Kestra.
###################################################################################

### Path Parameter: GetCompanyStatus_ticker
@GetCompanyStatus_ticker = str


GET {{baseUrl}}/api/companies/{{GetCompanyStatus_ticker}}/status
Content-Type: {{contentType}}
Authorization: {{internalToken}}


########################################################################################################################
### Request: POST /api/filing-batches
### Summary: Create Batch
### Description: Submit all enabled companies or an explicit ordered ticker subset for latest or exact-year ingestion.
########################################################################################################################


POST {{baseUrl}}/api/filing-batches
Content-Type: {{contentType}}
Authorization: {{internalToken}}

{
  "fiscal_year": 0,
  "tickers": ["item"]
}

###########################################################################################
### Request: POST /api/companies/{ticker}/filing-preparations
### Summary: Create Preparation
### Description: Submit one configured company for latest or exact fiscal-year ingestion.
###########################################################################################

### Path Parameter: PostCreateCompanyFilingPreparation_ticker
@PostCreateCompanyFilingPreparation_ticker = str


POST {{baseUrl}}/api/companies/{{PostCreateCompanyFilingPreparation_ticker}}/filing-preparations
Content-Type: {{contentType}}
Authorization: {{internalToken}}

{
  "fiscal_year": 0
}

##############################################################################
### Request: GET /api/filing-batches/{batch_id}
### Summary: Get Batch
### Description: Read authoritative overall and per-company workflow status.
##############################################################################

### Path Parameter: GetFilingBatch_batch_id
@GetFilingBatch_batch_id = str


GET {{baseUrl}}/api/filing-batches/{{GetFilingBatch_batch_id}}
Content-Type: {{contentType}}
Authorization: {{internalToken}}


#################################
### Request: POST /api/feedback
### Summary: Save Feedback
#################################


POST {{baseUrl}}/api/feedback
Content-Type: {{contentType}}
Authorization: {{internalToken}}

{
  "result_type": "example",
  "result_id": "example",
  "rating": "example"
}

############################################################################################
### Request: GET /api/retrieval-evaluations/current
### Summary: Current
### Description: Read the validated current retrieval evaluation and official leaderboard.
############################################################################################


GET {{baseUrl}}/api/retrieval-evaluations/current
Content-Type: {{contentType}}
Authorization: {{internalToken}}


#################################################################################################
### Request: GET /api/retrieval-evaluations/current/configurations/{configuration_id}/cases
### Summary: Cases
### Description: Inspect every reviewed question and ranked chunk for one stable configuration.
#################################################################################################

### Path Parameter: GetCurrentRetrievalEvaluationCases_configuration_id
@GetCurrentRetrievalEvaluationCases_configuration_id = str


GET {{baseUrl}}/api/retrieval-evaluations/current/configurations/{{GetCurrentRetrievalEvaluationCases_configuration_id}}/cases
Content-Type: {{contentType}}
Authorization: {{internalToken}}


#######################################################################################################
### Request: GET /api/retrieval-evaluations/current/chunks/{chunk_id}
### Summary: Chunk
### Description: Lazy-load full text and provenance for a chunk referenced by the current evaluation.
#######################################################################################################

### Path Parameter: GetCurrentRetrievalEvaluationChunk_chunk_id
@GetCurrentRetrievalEvaluationChunk_chunk_id = str


GET {{baseUrl}}/api/retrieval-evaluations/current/chunks/{{GetCurrentRetrievalEvaluationChunk_chunk_id}}
Content-Type: {{contentType}}
Authorization: {{internalToken}}


#################################
### Request: POST /api/research
### Summary: Create Research
#################################


POST {{baseUrl}}/api/research
Content-Type: {{contentType}}
Authorization: {{internalToken}}

{
  "ticker": "example",
  "corpus_version_id": "example",
  "goal": "example"
}

########################################
### Request: POST /api/research/stream
### Summary: Stream Research
########################################


POST {{baseUrl}}/api/research/stream
Content-Type: {{contentType}}
Authorization: {{internalToken}}

{
  "ticker": "example",
  "corpus_version_id": "example",
  "goal": "example"
}

########################################
### Request: GET /api/research/history
### Summary: Research History
########################################

### Query Parameter: GetResearch_history_api_research_history_get_limit
@GetResearch_history_api_research_history_get_limit = 0

### Query Parameter: GetResearch_history_api_research_history_get_cursor
@GetResearch_history_api_research_history_get_cursor = str


GET {{baseUrl}}/api/research/history?limit={{GetResearch_history_api_research_history_get_limit}}&cursor={{GetResearch_history_api_research_history_get_cursor}}
Content-Type: {{contentType}}
Authorization: {{internalToken}}


##############################################
### Request: GET /api/research/{research_id}
### Summary: Get Research
##############################################

### Path Parameter: Get_research_api_research__research_id__get_research_id
@Get_research_api_research__research_id__get_research_id = str


GET {{baseUrl}}/api/research/{{Get_research_api_research__research_id__get_research_id}}
Content-Type: {{contentType}}
Authorization: {{internalToken}}


######################################################
### Request: GET /internal/filing-batches/{batch_id}
### Summary: Get Execution Batch
######################################################

### Path Parameter: GetFilingBatchExecution_batch_id
@GetFilingBatchExecution_batch_id = str


GET {{baseUrl}}/internal/filing-batches/{{GetFilingBatchExecution_batch_id}}
Content-Type: {{contentType}}
Authorization: {{internalToken}}


####################################################################################
### Request: POST /internal/filing-items/{item_id}/failures
### Summary: Fail Item
### Description: Record a safe terminal item failure after an orchestration error.
####################################################################################

### Path Parameter: PostFailFilingBatchItem_item_id
@PostFailFilingBatchItem_item_id = str


POST {{baseUrl}}/internal/filing-items/{{PostFailFilingBatchItem_item_id}}/failures
Content-Type: {{contentType}}
Authorization: {{internalToken}}

{
  "error": "example",
  "kestra_execution_id": "example"
}

################################################################################
### Request: POST /internal/filing-batches/{batch_id}/finalizations
### Summary: Finalize
### Description: Finalize aggregate state and fail any stranded running items.
################################################################################

### Path Parameter: PostFinalizeFilingBatch_batch_id
@PostFinalizeFilingBatch_batch_id = str


POST {{baseUrl}}/internal/filing-batches/{{PostFinalizeFilingBatch_batch_id}}/finalizations
Content-Type: {{contentType}}
Authorization: {{internalToken}}

{
  "kestra_execution_id": "example"
}

####################################################################################
### Request: POST /internal/providers/filing-items/{item_id}/selection
### Summary: Select
### Description: Select the latest original 10-K or an exact SEC report-date year.
####################################################################################

### Path Parameter: PostSelectFilingForBatchItem_item_id
@PostSelectFilingForBatchItem_item_id = str


POST {{baseUrl}}/internal/providers/filing-items/{{PostSelectFilingForBatchItem_item_id}}/selection
Content-Type: {{contentType}}
Authorization: {{internalToken}}

{
  "kestra_execution_id": "example"
}

#######################################################################################################
### Request: POST /internal/providers/filing-items/{item_id}/acquisitions
### Summary: Acquire
### Description: Validate and persist selected filing HTML; return only a safe acquisition reference.
#######################################################################################################

### Path Parameter: PostAcquireSelectedFiling_item_id
@PostAcquireSelectedFiling_item_id = str


POST {{baseUrl}}/internal/providers/filing-items/{{PostAcquireSelectedFiling_item_id}}/acquisitions
Content-Type: {{contentType}}
Authorization: {{internalToken}}

{
  "kestra_execution_id": "example"
}

###############################################################################################
### Request: POST /internal/corpus-executions/{item_id}
### Summary: Process
### Description: Build a corpus from a persisted acquisition and promote only in latest mode.
###############################################################################################

### Path Parameter: PostExecuteCorpusForBatchItem_item_id
@PostExecuteCorpusForBatchItem_item_id = str


POST {{baseUrl}}/internal/corpus-executions/{{PostExecuteCorpusForBatchItem_item_id}}
Content-Type: {{contentType}}
Authorization: {{internalToken}}

{
  "kestra_execution_id": "example"
}
