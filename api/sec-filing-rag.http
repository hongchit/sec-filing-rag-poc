@baseUrl = http://{{$processEnv APP_HOST}}:{{$processEnv APP_PORT}}
@internalToken = {{$processEnv INGESTION_API_TOKEN}}
@contentType = application/json

########################################################
### Request: GET /api/health
### Summary: Health
### Description: Check application database readiness.
########################################################


GET {{baseUrl}}/api/health
Content-Type: {{contentType}}
Authorization: {{internalToken}}


#########################################
### Request: GET /api/auth/google/login
### Summary: Google Login
#########################################

### Query Parameter: GetGoogle_login_api_auth_google_login_get_return_to
@GetGoogle_login_api_auth_google_login_get_return_to = str

### Query Parameter: GetGoogle_login_api_auth_google_login_get_policy_acknowledged
@GetGoogle_login_api_auth_google_login_get_policy_acknowledged = true


GET {{baseUrl}}/api/auth/google/login?return_to={{GetGoogle_login_api_auth_google_login_get_return_to}}&policy_acknowledged={{GetGoogle_login_api_auth_google_login_get_policy_acknowledged}}
Content-Type: {{contentType}}
Authorization: {{internalToken}}


############################################
### Request: GET /api/auth/google/callback
### Summary: Google Callback
############################################


GET {{baseUrl}}/api/auth/google/callback
Content-Type: {{contentType}}
Authorization: {{internalToken}}


###############################
### Request: GET /api/auth/me
### Summary: Me
###############################


GET {{baseUrl}}/api/auth/me
Content-Type: {{contentType}}
Authorization: {{internalToken}}


####################################
### Request: POST /api/auth/logout
### Summary: Logout
####################################


POST {{baseUrl}}/api/auth/logout
Content-Type: {{contentType}}
Authorization: {{internalToken}}


##################################################################
### Request: GET /api/companies
### Summary: Companies
### Description: List configured companies and corpus readiness.
##################################################################


GET {{baseUrl}}/api/companies
Content-Type: {{contentType}}
Authorization: {{internalToken}}


###################################################################################
### Request: GET /api/companies/{ticker}/status
### Summary: Company Status
### Description: Inspect application-owned corpus status without querying Kestra.
###################################################################################

### Path Parameter: GetCompanyStatus_ticker
@GetCompanyStatus_ticker = str


GET {{baseUrl}}/api/companies/{{GetCompanyStatus_ticker}}/status
Content-Type: {{contentType}}
Authorization: {{internalToken}}


###########################################################
### Request: GET /api/corpus/versions/{corpus_version_id}
### Summary: Version
###########################################################

### Path Parameter: GetCorpusVersion_corpus_version_id
@GetCorpusVersion_corpus_version_id = str


GET {{baseUrl}}/api/corpus/versions/{{GetCorpusVersion_corpus_version_id}}
Content-Type: {{contentType}}
Authorization: {{internalToken}}


########################################################################
### Request: GET /api/corpus/versions/{corpus_version_id}/items/{item}
### Summary: Item Document
########################################################################

### Path Parameter: GetCorpusItem_corpus_version_id
@GetCorpusItem_corpus_version_id = str

### Path Parameter: GetCorpusItem_item
@GetCorpusItem_item = str

### Query Parameter: GetCorpusItem_chunk_id
@GetCorpusItem_chunk_id = str


GET {{baseUrl}}/api/corpus/versions/{{GetCorpusItem_corpus_version_id}}/items/{{GetCorpusItem_item}}?chunk_id={{GetCorpusItem_chunk_id}}
Content-Type: {{contentType}}
Authorization: {{internalToken}}


#########################################################
### Request: GET /api/corpus/chunks/{chunk_id}/location
### Summary: Chunk Location
#########################################################

### Path Parameter: GetCorpusChunkLocation_chunk_id
@GetCorpusChunkLocation_chunk_id = str


GET {{baseUrl}}/api/corpus/chunks/{{GetCorpusChunkLocation_chunk_id}}/location
Content-Type: {{contentType}}
Authorization: {{internalToken}}


########################################################################################################################
### Request: POST /api/filing-batches
### Summary: Create Batch
### Description: Submit all enabled companies or an explicit ordered ticker subset for latest or exact-year ingestion.
########################################################################################################################


POST {{baseUrl}}/api/filing-batches
Content-Type: {{contentType}}
Authorization: {{internalToken}}

{
  "fiscal_year": 0,
  "tickers": ["item"]
}

###########################################################################################
### Request: POST /api/companies/{ticker}/filing-preparations
### Summary: Create Preparation
### Description: Submit one configured company for latest or exact fiscal-year ingestion.
###########################################################################################

### Path Parameter: PostCreateCompanyFilingPreparation_ticker
@PostCreateCompanyFilingPreparation_ticker = str


POST {{baseUrl}}/api/companies/{{PostCreateCompanyFilingPreparation_ticker}}/filing-preparations
Content-Type: {{contentType}}
Authorization: {{internalToken}}

{
  "fiscal_year": 0
}

##############################################################################
### Request: GET /api/filing-batches/{batch_id}
### Summary: Get Batch
### Description: Read authoritative overall and per-company workflow status.
##############################################################################

### Path Parameter: GetFilingBatch_batch_id
@GetFilingBatch_batch_id = str


GET {{baseUrl}}/api/filing-batches/{{GetFilingBatch_batch_id}}
Content-Type: {{contentType}}
Authorization: {{internalToken}}


#################################
### Request: POST /api/feedback
### Summary: Save Feedback
#################################


POST {{baseUrl}}/api/feedback
Content-Type: {{contentType}}
Authorization: {{internalToken}}

{
  "result_type": "example",
  "result_id": "example",
  "rating": "example"
}

############################################################################################
### Request: GET /api/retrieval-evaluations/current
### Summary: Current
### Description: Read the validated current retrieval evaluation and official leaderboard.
############################################################################################


GET {{baseUrl}}/api/retrieval-evaluations/current
Content-Type: {{contentType}}
Authorization: {{internalToken}}


#################################################################################################
### Request: GET /api/retrieval-evaluations/current/configurations/{configuration_id}/cases
### Summary: Cases
### Description: Inspect every reviewed question and ranked chunk for one stable configuration.
#################################################################################################

### Path Parameter: GetCurrentRetrievalEvaluationCases_configuration_id
@GetCurrentRetrievalEvaluationCases_configuration_id = str


GET {{baseUrl}}/api/retrieval-evaluations/current/configurations/{{GetCurrentRetrievalEvaluationCases_configuration_id}}/cases
Content-Type: {{contentType}}
Authorization: {{internalToken}}


#######################################################################################################
### Request: GET /api/retrieval-evaluations/current/chunks/{chunk_id}
### Summary: Chunk
### Description: Lazy-load full text and provenance for a chunk referenced by the current evaluation.
#######################################################################################################

### Path Parameter: GetCurrentRetrievalEvaluationChunk_chunk_id
@GetCurrentRetrievalEvaluationChunk_chunk_id = str


GET {{baseUrl}}/api/retrieval-evaluations/current/chunks/{{GetCurrentRetrievalEvaluationChunk_chunk_id}}
Content-Type: {{contentType}}
Authorization: {{internalToken}}


###########################################################################
### Request: GET /api/generation-evaluations/current
### Summary: Current
### Description: Read the current portable generation evaluation summary.
###########################################################################


GET {{baseUrl}}/api/generation-evaluations/current
Content-Type: {{contentType}}
Authorization: {{internalToken}}


##########################################################################################
### Request: GET /api/generation-evaluations/current/cases
### Summary: Cases
### Description: Read question-by-prompt verdicts for the current generation evaluation.
##########################################################################################


GET {{baseUrl}}/api/generation-evaluations/current/cases
Content-Type: {{contentType}}
Authorization: {{internalToken}}


############################################################################
### Request: GET /api/generation-evaluations/current/questions/{case_id}
### Summary: Question
### Description: Compare every generated answer for one reviewed question.
############################################################################

### Path Parameter: GetCurrentGenerationEvaluationQuestion_case_id
@GetCurrentGenerationEvaluationQuestion_case_id = str


GET {{baseUrl}}/api/generation-evaluations/current/questions/{{GetCurrentGenerationEvaluationQuestion_case_id}}
Content-Type: {{contentType}}
Authorization: {{internalToken}}


##########################################################################
### Request: GET /api/generation-evaluations/current/prompts/{prompt_id}
### Summary: Prompt
### Description: Read checksum-verified source for one evaluated prompt.
##########################################################################

### Path Parameter: GetCurrentGenerationEvaluationPrompt_prompt_id
@GetCurrentGenerationEvaluationPrompt_prompt_id = str


GET {{baseUrl}}/api/generation-evaluations/current/prompts/{{GetCurrentGenerationEvaluationPrompt_prompt_id}}
Content-Type: {{contentType}}
Authorization: {{internalToken}}


###########################################################################################
### Request: GET /api/generation-evaluations/current/chunks/{chunk_id}
### Summary: Chunk
### Description: Read optional database-backed evidence referenced by the generation run.
###########################################################################################

### Path Parameter: GetCurrentGenerationEvaluationChunk_chunk_id
@GetCurrentGenerationEvaluationChunk_chunk_id = str


GET {{baseUrl}}/api/generation-evaluations/current/chunks/{{GetCurrentGenerationEvaluationChunk_chunk_id}}
Content-Type: {{contentType}}
Authorization: {{internalToken}}


