@Get_research_api_research__research_id__get_research_id = str


GET {{baseUrl}}/api/research/{{Get_research_api_research__research_id__get_research_id}}
Content-Type: {{contentType}}
Authorization: {{internalToken}}


##############################################
### Request: GET /api/admin/model-executions
### Summary: Model Executions
##############################################

### Query Parameter: GetModel_executions_api_admin_model_executions_get_limit
@GetModel_executions_api_admin_model_executions_get_limit = 0

### Query Parameter: GetModel_executions_api_admin_model_executions_get_offset
@GetModel_executions_api_admin_model_executions_get_offset = 0


GET {{baseUrl}}/api/admin/model-executions?limit={{GetModel_executions_api_admin_model_executions_get_limit}}&offset={{GetModel_executions_api_admin_model_executions_get_offset}}
Content-Type: {{contentType}}
Authorization: {{internalToken}}


###################################
### Request: GET /api/admin/users
### Summary: Users
###################################

### Query Parameter: GetUsers_api_admin_users_get_limit
@GetUsers_api_admin_users_get_limit = 0

### Query Parameter: GetUsers_api_admin_users_get_search
@GetUsers_api_admin_users_get_search = str


GET {{baseUrl}}/api/admin/users?limit={{GetUsers_api_admin_users_get_limit}}&search={{GetUsers_api_admin_users_get_search}}
Content-Type: {{contentType}}
Authorization: {{internalToken}}


######################################################
### Request: GET /api/admin/users/{user_id}/activity
### Summary: Activity
######################################################

### Path Parameter: GetActivity_api_admin_users__user_id__activity_get_user_id
@GetActivity_api_admin_users__user_id__activity_get_user_id = str

### Query Parameter: GetActivity_api_admin_users__user_id__activity_get_limit
@GetActivity_api_admin_users__user_id__activity_get_limit = 0


GET {{baseUrl}}/api/admin/users/{{GetActivity_api_admin_users__user_id__activity_get_user_id}}/activity?limit={{GetActivity_api_admin_users__user_id__activity_get_limit}}
Content-Type: {{contentType}}
Authorization: {{internalToken}}


###############################################
### Request: PATCH /api/admin/users/{user_id}
### Summary: Update User
###############################################

### Path Parameter: PatchUpdate_user_api_admin_users__user_id__patch_user_id
@PatchUpdate_user_api_admin_users__user_id__patch_user_id = str


PATCH {{baseUrl}}/api/admin/users/{{PatchUpdate_user_api_admin_users__user_id__patch_user_id}}
Content-Type: {{contentType}}
Authorization: {{internalToken}}

{
  "status": "example",
  "lifetime_budget_override_usd": 0.0,
  "clear_budget_override": true
}

######################################################
### Request: GET /internal/filing-batches/{batch_id}
### Summary: Get Execution Batch
######################################################

### Path Parameter: GetFilingBatchExecution_batch_id
@GetFilingBatchExecution_batch_id = str


GET {{baseUrl}}/internal/filing-batches/{{GetFilingBatchExecution_batch_id}}
Content-Type: {{contentType}}
Authorization: {{internalToken}}


####################################################################################
### Request: POST /internal/filing-items/{item_id}/failures
### Summary: Fail Item
### Description: Record a safe terminal item failure after an orchestration error.
####################################################################################

### Path Parameter: PostFailFilingBatchItem_item_id
@PostFailFilingBatchItem_item_id = str


POST {{baseUrl}}/internal/filing-items/{{PostFailFilingBatchItem_item_id}}/failures
Content-Type: {{contentType}}
Authorization: {{internalToken}}

{
  "error": "example",
  "kestra_execution_id": "example"
}

################################################################################
### Request: POST /internal/filing-batches/{batch_id}/finalizations
### Summary: Finalize
### Description: Finalize aggregate state and fail any stranded running items.
################################################################################

### Path Parameter: PostFinalizeFilingBatch_batch_id
@PostFinalizeFilingBatch_batch_id = str


POST {{baseUrl}}/internal/filing-batches/{{PostFinalizeFilingBatch_batch_id}}/finalizations
Content-Type: {{contentType}}
Authorization: {{internalToken}}

{
  "kestra_execution_id": "example"
}

####################################################################################
### Request: POST /internal/providers/filing-items/{item_id}/selection
### Summary: Select
### Description: Select the latest original 10-K or an exact SEC report-date year.
####################################################################################

### Path Parameter: PostSelectFilingForBatchItem_item_id
@PostSelectFilingForBatchItem_item_id = str


POST {{baseUrl}}/internal/providers/filing-items/{{PostSelectFilingForBatchItem_item_id}}/selection
Content-Type: {{contentType}}
Authorization: {{internalToken}}

{
  "kestra_execution_id": "example"
}

#######################################################################################################
### Request: POST /internal/providers/filing-items/{item_id}/acquisitions
### Summary: Acquire
### Description: Validate and persist selected filing HTML; return only a safe acquisition reference.
#######################################################################################################

### Path Parameter: PostAcquireSelectedFiling_item_id
@PostAcquireSelectedFiling_item_id = str


POST {{baseUrl}}/internal/providers/filing-items/{{PostAcquireSelectedFiling_item_id}}/acquisitions
Content-Type: {{contentType}}
Authorization: {{internalToken}}

{
  "kestra_execution_id": "example"
}

###############################################################################################
### Request: POST /internal/corpus-executions/{item_id}
### Summary: Process
### Description: Build a corpus from a persisted acquisition and promote only in latest mode.
###############################################################################################

### Path Parameter: PostExecuteCorpusForBatchItem_item_id
@PostExecuteCorpusForBatchItem_item_id = str


POST {{baseUrl}}/internal/corpus-executions/{{PostExecuteCorpusForBatchItem_item_id}}
Content-Type: {{contentType}}
Authorization: {{internalToken}}

{
  "kestra_execution_id": "example"
}
