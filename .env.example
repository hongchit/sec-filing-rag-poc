# Copy to .env, replace every placeholder, and never commit the resulting file.

# SEC gateway: use a truthful product/contact identity required by SEC policy.
EDGAR_IDENTITY=sec-filing-rag-poc/0.1 your-name your-email@example.com
EDGAR_RATE_LIMIT_PER_SEC=6
EDGAR_ACCESS_MODE=CAUTION
MAX_FILING_DOCUMENT_BYTES=50000000
MAX_FILING_NARRATIVE_CHARS=20000000

# OpenAI embedding gateway.
OPENAI_API_KEY=change-me
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
OPENAI_TIMEOUT_SECONDS=30

# FastAPI and corpus behavior.
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
INGESTION_API_TOKEN=change-me-at-least-16-characters
COMPANY_CONFIG_PATH=config/companies.yaml
CHUNK_SIZE_CHARS=2400
CHUNK_OVERLAP_CHARS=240
PARSER_VERSION=corpus-heading-sanitized-v2
CHUNKING_VERSION=character-v1
INDEX_VERSION=vector-v1

# Initialization credentials used by the two isolated PostgreSQL containers.
# DATABASE_URL is used only by the application and points to its PostgreSQL service.
POSTGRES_DB=sec_filings
POSTGRES_USER=sec_filings
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://sec_filings:change-me@db:5432/sec_filings
DATABASE_POOL_MIN_SIZE=1
DATABASE_POOL_MAX_SIZE=10
DATABASE_POOL_TIMEOUT_SECONDS=10
DATABASE_STARTUP_TIMEOUT_SECONDS=10

# Kestra server and FastAPI-to-Kestra execution client.
KESTRA_BASIC_AUTH_USERNAME=admin@example.com
# Kestra requires 8+ non-whitespace characters with an uppercase letter and digit.
KESTRA_BASIC_AUTH_PASSWORD=ChangeMe1234
KESTRA_API_URL=http://kestra:8080/api/v1/main
KESTRA_NAMESPACE=sec_filings.ingestion
KESTRA_BATCH_FLOW_ID=filing_batch
KESTRA_TIMEOUT_SECONDS=10
KESTRA_MAX_RETRIES=2

# Kestra reads base64-encoded environment secrets with the SECRET_ prefix.
# Encode the same raw value used by INGESTION_API_TOKEN:
# printf %s 'token-value' | base64 | tr -d '\n'
SECRET_INGESTION_API_TOKEN=change-me-base64
