POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Local Kestra Basic Auth credentials.
KESTRA_BASIC_AUTH_USERNAME=admin@kestra.io
KESTRA_BASIC_AUTH_PASSWORD=kestra

# Gemini API key used by Kestra AI Copilot.
GEMINI_API_KEY=

# Kestra secrets must be base64-encoded values. Generate one with:
# printf %s "your-secret" | base64 | tr -d '\n'; printf '\n'
SECRET_GEMINI_API_KEY=
SECRET_OPENAI_API_KEY=
SECRET_TAVILY_API_KEY=

# Grafana credentials used for the Grafana dashboard.
GRAFANA_USERNAME=
GRAFANA_PASSWORD=