    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-router-dom": "7.18.2",
    "vanilla-cookieconsent": "^3.1.0",
    "vite": "7.1.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/jest-dom": "6.6.4",
    "@testing-library/react": "16.3.0",
